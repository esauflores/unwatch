{
  "name": "unwatch",
  "version": "0.0.1",
  "private": true,
  "author": "esauflores (https://github.com/esauflores)",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "package": "node build.mjs && cd dist && rm -f ../unwatch.zip && zip -qr ../unwatch.zip . && cd .. && echo 'unwatch.zip ready for the Chrome Web Store'"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.47",
    "@ai-sdk/google": "^4.0.61",
    "@ai-sdk/openai": "^4.0.55",
    "ai": "^7.0.89",
    "deep-chat": "^2.5.1",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.23.0"
}
